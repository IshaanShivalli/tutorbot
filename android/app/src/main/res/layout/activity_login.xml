<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#12161f"
    tools:context=".LoginActivity">

    <!-- Top Glow Layout for Logo -->
    <LinearLayout
        android:id="@+id/logo_area"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginTop="80dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <View
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="@drawable/circular_avatar_placeholder" />

        <TextView
            android:id="@+id/auth_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TutorBot Studio"
            android:textColor="#ffffff"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            android:fontFamily="sans-serif-condensed-light" />

        <TextView
            android:id="@+id/auth_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Your Premium AI Study Space"
            android:textColor="#8d97a8"
            android:textSize="14sp"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <!-- Credentials Input Card -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="40dp"
        app:cardBackgroundColor="#1d222b"
        app:cardCornerRadius="24dp"
        app:cardElevation="6dp"
        app:layout_constraintTop_toBottomOf="@id/logo_area"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Username Field -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Username / Email"
                android:textColor="#8d97a8"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

            <EditText
                android:id="@+id/et_username"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="#12161f"
                android:hint="Enter your username"
                android:textColorHint="#555d6b"
                android:textColor="#ffffff"
                android:textSize="14sp"
                android:padding="12dp"
                android:inputType="textEmailAddress"
                android:singleLine="true" />

            <!-- Password Field -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Password"
                android:textColor="#8d97a8"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:layout_marginTop="16dp" />

            <EditText
                android:id="@+id/et_password"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="#12161f"
                android:hint="••••••••"
                android:textColorHint="#555d6b"
                android:textColor="#ffffff"
                android:textSize="14sp"
                android:padding="12dp"
                android:inputType="textPassword"
                android:singleLine="true" />

            <!-- Login / Signup Action Button -->
            <Button
                android:id="@+id/btn_auth_submit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:backgroundTint="#a855f7"
                android:text="Log In"
                android:textColor="#ffffff"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:insetBottom="0dp"
                android:insetTop="0dp" />

            <!-- Mode Switcher -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp">

                <TextView
                    android:id="@+id/tv_mode_helper"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="New to TutorBot?"
                    android:textColor="#8d97a8"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tv_switch_mode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" Create Account"
                    android:textColor="#a855f7"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
