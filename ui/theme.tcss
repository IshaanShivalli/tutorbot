/* ===================== BASE ===================== */

Screen {
    background: #0d1117;
    layers: base overlay;
}

/* ===================== CHAT AREA ===================== */

#chat {
    height: 1fr;
    padding: 1 2;
    scrollbar-size: 1 1;
    scrollbar-color: #21262d;
    scrollbar-color-hover: #58a6ff;
}

MessageBubble {
    width: 100%;
    padding: 0 2;
    margin: 0 0 1 0;
    border: none;
    background: transparent;
}

MessageBubble.user {
    border-left: solid #58a6ff;
    padding-left: 2;
}

MessageBubble.assistant {
    border-left: solid #3fb950;
    padding-left: 2;
}

MessageBubble.system {
    border: none;
    padding-left: 0;
}

MessageBubble.error {
    border-left: solid #f85149;
    padding-left: 2;
}

/* ===================== THINKING INDICATOR ===================== */

#thinking-indicator {
    height: auto;
    padding: 0 2 1 2;
    color: #8b949e;
}

/* ===================== COMMAND PALETTE / SUGGESTIONS ===================== */

#suggestions {
    dock: bottom;
    height: auto;
    max-height: 8;
    background: #161b22;
    border: round #30363d;
    margin: 0 2;
    display: none;
}

#suggestions.visible {
    display: block;
}

.suggestion-item {
    padding: 0 1;
    color: #8b949e;
}

.suggestion-item .cmd-name {
    color: #d2a8ff;
    text-style: bold;
}

/* ===================== INPUT BOX (GEMINI CLI STYLE) ===================== */

#input-row {
    dock: bottom;
    height: 3;
    padding: 0 2;
    margin: 1 2 0 2;
    border: round #30363d;
    background: #11161d;
    layout: horizontal;
    align: left middle;
}

#input-row:focus-within {
    border: round #58a6ff;
}

#prompt-symbol {
    width: auto;
    color: #d2a8ff;
    text-style: bold;
    margin-right: 1;
}

Input {
    border: none;
    background: transparent;
    height: 100%;
    padding: 0 1;
    margin: 0;
    width: 1fr;
}

Input:focus {
    border: none;
}

Input.disabled-input {
    border: none;
    background: transparent;
    color: #6e7681;
}

/* ===================== FOOTER BAR ===================== */

#cli-footer {
    dock: bottom;
    height: 1;
    padding: 0 2;
    margin: 0 0 1 0;
    color: #8b949e;
    background: transparent;
}